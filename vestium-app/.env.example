# ── Backend mode (Phase 2) ──────────────────────────────────────────────────
# When VITE_API_URL is set the Studio sends generation to the Fastify API
# instead of running Claude client-side. VITE_CLERK_PUBLISHABLE_KEY must
# also be set (both or neither — partial config is unsupported).
VITE_API_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Enable/disable Curriculum Studio route (/studio)
# true  = Studio visible
# false = Studio hidden (recommended for public demo unless you need it live)
VITE_ENABLE_STUDIO=false

# Optional: prefill Anthropic API key for Studio (client-side only)
# Leave blank for safety; user can paste key in Studio UI instead.
VITE_ANTHROPIC_API_KEY=

# Optional analytics (Plausible)
# If set, script is injected in src/main.tsx
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Optional external evidence provider keys (Studio validation enhancements)
VITE_OPENALEX_API_KEY=
VITE_SEMANTICSCHOLAR_API_KEY=
VITE_NVD_API_KEY=
VITE_OPENFDA_API_KEY=
VITE_GOOGLE_FACTCHECK_API_KEY=
VITE_UNSPLASH_API_KEY=
VITE_PEXELS_API_KEY=
VITE_PIXABAY_API_KEY=
