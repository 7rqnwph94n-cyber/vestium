# ── Vestium E2E Test Configuration ────────────────────────────────
# Copy to .env.e2e and fill in your values.

# Required: Clerk secret key (same as your API .env)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Option A: Single admin account for all 3 personas (simplest)
E2E_USER_EMAIL=your-admin@example.com

# Option B: Separate emails per persona (more realistic)
# E2E_REVIEWER_EMAIL=reviewer@example.com
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_LEARNER_EMAIL=learner@example.com
