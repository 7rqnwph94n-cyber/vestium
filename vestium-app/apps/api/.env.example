# ─── ComplianceForge API — Production Environment Variables ──────────────────
# Copy this file to .env and fill in values before running locally.
# In Railway: set these in the service's "Variables" tab.
# Never commit a .env file with real values.

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon pooled connection string. Found in Neon dashboard → Connection Details.
DATABASE_URL=

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Production secret key from Clerk dashboard → API Keys (sk_live_...).
CLERK_SECRET_KEY=

# ─── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Pipeline provider routing (optional — defaults to anthropic) ─────────────
PIPELINE_AI_PROVIDER=anthropic
PIPELINE_PROVIDER_FACTCHECK=
PIPELINE_PROVIDER_SOURCE_ATTRIBUTION=
PIPELINE_PROVIDER_CRITIQUE=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Free tier covers pilot volume. If absent: stale alerts suppressed silently.
RESEND_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins. In Railway: set to your frontend URL.
# Example: https://complianceforge-frontend.up.railway.app
# For local dev: leave unset (all localhost/127.0.0.1 ports allowed).
CORS_ORIGIN=

# ─── Port ─────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — do not set in Railway.
# Local dev: defaults to 3001.
PORT=

# ─── Optional: Verbal transcription (Phase 6) ────────────────────────────────
OPENAI_API_KEY=
